---
import { filled, outline, type IconName } from '../icons';

interface Props {
  name: IconName;
  variant?: 'filled' | 'outline';
  size?: number;
  class?: string;
}

const { name, variant = 'filled', size = 18, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class={className}
  aria-hidden="true"
  {...variant === 'filled'
    ? { fill: 'currentColor' }
    : { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }}
>
  {(variant === 'filled' ? filled : outline)[name].map((d) => <path d={d} />)}
</svg>
