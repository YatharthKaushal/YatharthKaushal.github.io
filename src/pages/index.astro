---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../site.config';
import { homeLd, postDescription, postPath, publishedPosts } from '../lib/seo';

const posts = await publishedPosts();

const fmt = (d: Date) => d.toISOString().slice(0, 10);

// Link the first mention of the employer in the intro.
const { name: org, url: orgUrl } = site.author.worksFor;
const orgAt = site.intro.findIndex((p) => p.includes(org));
---

<Base jsonLd={homeLd(posts)}>
  <header>
    <h1 class="settle">{site.name}</h1>
    <div class="intro settle">
      {site.intro.map((para, i) => {
        if (i !== orgAt) return <p>{para}</p>;
        const [before, ...rest] = para.split(org);
        return <p>{before}<a class="quiet-link" href={orgUrl}>{org}</a>{rest.join(org)}</p>;
      })}
    </div>
    <div class="settle"><SocialLinks /></div>
  </header>

  <section class="settle">
    <h2>Writing</h2>
    {posts.length === 0 ? (
      <p class="muted">Nothing here yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a class="post-card pixel-card" href={postPath(p)}>
              <div class="row">
                <span class="title">{p.data.title}</span>
                <time class="date" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              </div>
              <p class="desc">{postDescription(p)}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
